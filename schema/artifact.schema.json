{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/amsonix/trellis/main/schema/artifact.schema.json",
  "title": "Trellis artifact front-matter",
  "type": "object",
  "required": ["id", "project", "stage", "status", "owners", "version"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "stage": {
      "type": "string",
      "enum": ["intake", "discovery", "architecture", "plan", "ready", "executing", "integrating", "releasing", "maintained"]
    },
    "status": { "type": "string", "enum": ["draft", "review", "approved"] },
    "owners": {
      "type": "array",
      "items": { "type": "string" }
    },
    "version": { "type": "integer", "minimum": 1 },
    "created": { "type": "string" }
  },
  "additionalProperties": true
}
