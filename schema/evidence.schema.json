{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/amsonix/trellis/main/schema/evidence.schema.json",
  "title": "Trellis evidence",
  "type": "object",
  "required": [
    "id",
    "taskId",
    "kind",
    "uri",
    "verdict",
    "producedBy",
    "producedAt"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "add",
        "retract"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^T-[0-9]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "test",
        "benchmark",
        "review",
        "approval",
        "log",
        "screenshot",
        "doc"
      ]
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "producedBy": {
      "type": "string",
      "minLength": 1
    },
    "producedAt": {
      "type": "string"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "retracted": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "by",
        "at",
        "reason"
      ],
      "additionalProperties": false
    },
    "agent": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "description": "One line of .trellis/evidence.jsonl. An \"add\" event carries the record; a \"retract\" event carries id, by, at and reason."
}
