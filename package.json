{
  "name": "@amsonix/trellis",
  "version": "0.9.8",
  "description": "Trellis: an agent-facing protocol for building projects: stages, artifacts, gates, roles, tasks and evidence.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amsonix/trellis.git"
  },
  "homepage": "https://github.com/amsonix/trellis#readme",
  "bugs": {
    "url": "https://github.com/amsonix/trellis/issues"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./cli": "./src/cli.mjs"
  },
  "bin": {
    "trellis": "./bin/trellis.mjs",
    "trellis-mcp": "./bin/trellis-mcp.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "skills/",
    "schema/",
    "README.md",
    "SPEC.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "coverage": "node scripts/coverage-gate.mjs",
    "check": "node --test && node bin/trellis.mjs --version",
    "demo": "node bin/trellis.mjs init /tmp/trellis-demo"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "agents",
    "project-management",
    "protocol",
    "gates",
    "artifacts",
    "evidence"
  ],
  "publishConfig": {
    "access": "public"
  }
}
